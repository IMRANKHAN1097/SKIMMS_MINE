rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email', 'role']) &&
             data.userId is string &&
             data.email is string &&
             (data.role == 'admin' || data.role == 'worker');
    }

    function isValidWorker(data) {
      return data.keys().hasAll(['workerId', 'helmetNumber', 'workerName', 'workerPin', 'deviceKey']) &&
             data.workerId is string &&
             data.helmetNumber is string &&
             data.workerName is string &&
             data.workerPin is string &&
             data.deviceKey is string;
    }

    function isValidTelemetry(data) {
      return data.keys().hasAll(['workerId', 'mq4', 'mq135', 'accel', 'ir', 'riskScore', 'alertLevel']) &&
             data.workerId is string &&
             data.mq4 is number &&
             data.mq135 is number &&
             data.accel is number &&
             data.ir is number &&
             data.riskScore is number &&
             data.alertLevel in ['SAFE', 'CAUTION', 'DANGER', 'CRITICAL'];
    }

    function isValidAlert(data) {
      return data.keys().hasAll(['workerId', 'helmetNumber', 'alertLevel', 'reason', 'acknowledged', 'escalated']) &&
             data.workerId is string &&
             data.helmetNumber is string &&
             data.alertLevel in ['CAUTION', 'DANGER', 'CRITICAL', 'SOS'] &&
             data.reason is string &&
             data.acknowledged is bool &&
             data.escalated is bool;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;
    }

    match /workers/{workerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidWorker(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /telemetry/{telemetryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidTelemetry(request.resource.data);
      allow update, delete: if false;
    }

    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidAlert(request.resource.data);
      allow update: if isAuthenticated() && isValidAlert(request.resource.data);
      allow delete: if isAuthenticated();
    }
  }
}
